{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compilar",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++17", "-Wall", "-Wextra", "-g", "src/main.cpp", "-o", "build/planificador.exe", "-pthread"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
